{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "functionAppName": {
      "type": "string"
    },
    "environmentName": {
      "type": "string",
      "metadata": {
        "description": "Short environment name, e.g. DAS, DST, SIT, ETE, MO, PP, PD. Applied as a resource tag."
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Name of the existing storage account used for the Flex Consumption deployment container"
      }
    },
    "vnetName": {
      "type": "string",
      "defaultValue": "[concat('DCOL-', parameters('environmentName'), '-VNET-WEU')]",
      "metadata": {
        "description": "VNet holding the function app integration subnet. Defaults to the DCOL-<ENV>-VNET-WEU naming pattern; override for environments that don't follow it."
      }
    },
    "vnetResourceGroupName": {
      "type": "string",
      "defaultValue": "[parameters('vnetName')]",
      "metadata": {
        "description": "Resource group holding the VNet. Defaults to the VNet name, which is the pattern used by every environment so far."
      }
    },
    "functionAppSubnetName": {
      "type": "string",
      "defaultValue": "DCOL-FunctionApp-Integration-Subnet"
    },
    "privateEndpointSubnetName": {
      "type": "string",
      "defaultValue": "DCOL-PrivateEndpoint-Subnet",
      "metadata": {
        "description": "Subnet that hosts the SQL private endpoint. Must NOT be the function app integration subnet: that one is delegated to the Functions platform, and Azure does not permit private endpoints in a delegated subnet. Must also have privateEndpointNetworkPolicies disabled."
      }
    },
    "privateEndpointName": {
      "type": "string",
      "defaultValue": "[concat(parameters('functionAppName'), '-ne-sql-pe')]",
      "metadata": {
        "description": "Name of the SQL private endpoint. Only used in MO and PD."
      }
    },
    "sqlServerResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Full resource id of the target SQL server, e.g. /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Sql/servers/<server>. The server may live in another region or subscription. Required in MO and PD."
      }
    },
    "privateDnsZoneId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Full resource id of the privatelink.database.windows.net private DNS zone. The zone must already be linked to the function app's VNet. Leave empty to skip the DNS zone group and register DNS by hand."
      }
    },
    "privateEndpointManualApproval": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Set true when the deploying service principal cannot auto-approve the connection on the target SQL server, e.g. when the server is in another subscription. The connection is then created in Pending and someone must approve it on the SQL server."
      }
    },
    "templateBaseUri": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/SkillsFundingAgency/das-platform-building-blocks/master/",
      "metadata": {
        "description": "Base URI for shared das-platform-building-blocks templates. ARM fetches linked templates itself, so this must be publicly reachable."
      }
    },
    "deploymentContainerName": {
      "type": "string",
      "defaultValue": "app-package"
    },
    "maximumInstanceCount": {
      "type": "int",
      "defaultValue": 100
    },
    "instanceMemoryMB": {
      "type": "int",
      "defaultValue": 2048,
      "allowedValues": [
        512,
        2048,
        4096
      ]
    },
    "estimateSubmissionWindowMetricsSchedule": {
      "type": "string",
      "metadata": {
        "description": "NCRONTAB expression for the EstimateSubmissionWindowMetrics timer trigger"
      }
    },
    "sqlMaxRetryCount": {
      "type": "int",
      "defaultValue": 0
    },
    "sqlMaxRetryDelay": {
      "type": "int",
      "defaultValue": 0
    },
    "azureWebJobsStorage": {
      "type": "securestring",
      "metadata": {
        "description": "Connection string for the storage account the Functions host uses for internal state and for the deployment container"
      }
    },
    "paymentsConnectionString": {
      "type": "securestring"
    },
    "paymentsMetricsConnectionString": {
      "type": "securestring"
    },
    "dcEarnings2526ConnectionString": {
      "type": "securestring"
    },
    "dcEarnings2627ConnectionString": {
      "type": "securestring"
    },
    "appInsightsInstrumentationKey": {
      "type": "securestring",
      "metadata": {
        "description": "Value for the APPINSIGHTS_INSTRUMENTATIONKEY setting read by the Functions host"
      }
    },
    "applicationInsightsInstrumentationKey": {
      "type": "securestring",
      "metadata": {
        "description": "Value for the ApplicationInsightsInstrumentationKey setting read by the application"
      }
    },
    "applicationInsightsConnectionString": {
      "type": "securestring",
      "metadata": {
        "description": "Connection string for the Application Insights resource. Required on Flex Consumption, which has no filesystem log streaming"
      }
    }
  },
  "variables": {
    "functionAppApiVersion": "2023-12-01",
    "deploymentStorageContainerUri": "[concat('https://', parameters('storageAccountName'), '.blob.core.windows.net/', parameters('deploymentContainerName'))]",
    "functionAppSubnetId": "[resourceId(parameters('vnetResourceGroupName'), 'Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('functionAppSubnetName'))]",
    "privateEndpointSubnetId": "[resourceId(parameters('vnetResourceGroupName'), 'Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('privateEndpointSubnetName'))]",
    "deployPrivateEndpoint": "[or(equals(toUpper(parameters('environmentName')), 'MO'), equals(toUpper(parameters('environmentName')), 'PD'))]",
    "appSettings": [
      {
        "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
        "value": "[parameters('appInsightsInstrumentationKey')]"
      },
      {
        "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
        "value": "[parameters('applicationInsightsConnectionString')]"
      },
      {
        "name": "ApplicationInsightsInstrumentationKey",
        "value": "[parameters('applicationInsightsInstrumentationKey')]"
      },
      {
        "name": "AzureWebJobsStorage",
        "value": "[parameters('azureWebJobsStorage')]"
      },
      {
        "name": "DcEarnings2526ConnectionString",
        "value": "[parameters('dcEarnings2526ConnectionString')]"
      },
      {
        "name": "DcEarnings2627ConnectionString",
        "value": "[parameters('dcEarnings2627ConnectionString')]"
      },
      {
        "name": "DEPLOYMENT_STORAGE_CONNECTION_STRING",
        "value": "[parameters('azureWebJobsStorage')]"
      },
      {
        "name": "EstimateSubmissionWindowMetricsSchedule",
        "value": "[parameters('estimateSubmissionWindowMetricsSchedule')]"
      },
      {
        "name": "PaymentsConnectionString",
        "value": "[parameters('paymentsConnectionString')]"
      },
      {
        "name": "PaymentsMetricsConnectionString",
        "value": "[parameters('paymentsMetricsConnectionString')]"
      },
      {
        "name": "SqlMaxRetryCount",
        "value": "[string(parameters('sqlMaxRetryCount'))]"
      },
      {
        "name": "SqlMaxRetryDelay",
        "value": "[string(parameters('sqlMaxRetryDelay'))]"
      }
    ]
  },
  "resources": [
    {
      "name": "[parameters('functionAppName')]",
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "location": "[resourceGroup().location]",
      "tags": {
        "Environment": "[parameters('environmentName')]"
      },
      "sku": {
        "name": "FC1",
        "tier": "FlexConsumption"
      },
      "kind": "functionapp",
      "properties": {
        "reserved": true
      }
    },
    {
      "name": "[parameters('functionAppName')]",
      "type": "Microsoft.Web/sites",
      "kind": "functionapp,linux",
      "apiVersion": "[variables('functionAppApiVersion')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "Environment": "[parameters('environmentName')]"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('functionAppName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('functionAppName'))]",
        "virtualNetworkSubnetId": "[variables('functionAppSubnetId')]",
        "clientAffinityEnabled": false,
        "httpsOnly": true,
        "siteConfig": {
          "appSettings": "[variables('appSettings')]",
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled"
        },
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[variables('deploymentStorageContainerUri')]",
              "authentication": {
                "type": "StorageAccountConnectionString",
                "storageAccountConnectionStringName": "DEPLOYMENT_STORAGE_CONNECTION_STRING"
              }
            }
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": "[parameters('maximumInstanceCount')]",
            "instanceMemoryMB": "[parameters('instanceMemoryMB')]"
          },
          "runtime": {
            "name": "dotnet-isolated",
            "version": "8.0"
          }
        }
      }
    },
    {
      "name": "[concat(parameters('privateEndpointName'), '-deployment')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "condition": "[variables('deployPrivateEndpoint')]",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('templateBaseUri'), 'templates/private-endpoint.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "privateEndpointName": {
            "value": "[parameters('privateEndpointName')]"
          },
          "subnetId": {
            "value": "[variables('privateEndpointSubnetId')]"
          },
          "privateLinkServiceId": {
            "value": "[parameters('sqlServerResourceId')]"
          },
          "privateLinkGroupIds": {
            "value": [
              "sqlServer"
            ]
          },
          "privateDnsZoneId": {
            "value": "[parameters('privateDnsZoneId')]"
          },
          "manualApproval": {
            "value": "[parameters('privateEndpointManualApproval')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "managedServiceIdentityId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('functionAppApiVersion'), 'Full').identity.principalId]"
    }
  }
}
